AVTOPULSE_DSN=postgres://localhost:5432/avtopulse?sslmode=disable
AVTOPULSE_PORT=8090

# MinIO object storage (required — server refuses to start if any are missing)
AVTOPULSE_MINIO_ENDPOINT=127.0.0.1:9000
AVTOPULSE_MINIO_ACCESS_KEY=changeme
AVTOPULSE_MINIO_SECRET_KEY=changeme
AVTOPULSE_MINIO_BUCKET=avtopulse
AVTOPULSE_MINIO_PUBLIC_URL=http://127.0.0.1:9000/avtopulse

# Superadmin panel login (required — server refuses to start if either is missing)
ADMIN_USERNAME=changeme
ADMIN_PASSWORD=changeme

# Optional: AWS S3 dual-write mirror for uploads. Leave all 4 unset to run
# MinIO-only. If you set any one of them, all 4 must be set.
#AVTOPULSE_AWS_ACCESS_KEY_ID=changeme
#AVTOPULSE_AWS_SECRET_ACCESS_KEY=changeme
#AVTOPULSE_AWS_REGION=us-east-1
#AVTOPULSE_AWS_BUCKET=changeme
